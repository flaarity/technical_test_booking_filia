# Direct Vercel Prisma Postgres URL (postgres:// or postgresql://), not prisma+postgres://.
# Add sslmode=verify-full if required by the provider/pg driver.
DATABASE_URL=

# Clerk Dashboard -> API Keys. Secret key stays on the backend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Exact frontend origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Optional HTTP port (defaults to 4000).
PORT=4000

# Optional runtime mode; deployment platforms may set this themselves.
NODE_ENV=development

# Set your demo Worker/Admin email and name; Admin email must differ from Worker.
SEED_WORKER_EMAIL=
SEED_WORKER_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
